generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  phone     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
  role      Role @default(USER)
}
